{
  "version": 2,
  "builds": [
    {
      "src": "**/*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "uploads/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/",
      "dest": "/index.php"
    },
    {
      "src": "/guest/?",
      "dest": "/guest/index.php"
    },
    {
      "src": "/admin/?",
      "dest": "/admin/dashboard.php"
    },
    {
      "src": "/member/?",
      "dest": "/member/dashboard.php"
    },
    {
      "src": "/staff/?",
      "dest": "/staff/dashboard.php"
    },
    {
      "src": "/superadmin/?",
      "dest": "/superadmin/dashboard.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
